// resources/app.rc
// Placeholder resource file — replace icon with actual .ico before release

#include <windows.h>

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Application icon (add clipboardpp.ico to this directory to use it)
// IDI_APP ICON "clipboardpp.ico"

// Version info
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "clipboard-plus-plus"
            VALUE "FileDescription",  "Clipboard++ — Clipboard Manager"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "clipboardpp"
            VALUE "OriginalFilename", "clipboardpp.exe"
            VALUE "ProductName",      "Clipboard++"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
