// dbviewer/res/sqlite_editor.rc
#include <windows.h>

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// Application icon (numeric ID 1 = Windows default app icon)
1 ICON "..\..\icons\sqlite_editor.ico"

// DPI-aware manifest
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sqlite_editor.manifest"

// Version info
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "clipboard-plus-plus"
            VALUE "FileDescription",  "SQLite Editor - Clipboard++ Tool"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "sqlite_editor"
            VALUE "OriginalFilename", "sqlite_editor.exe"
            VALUE "ProductName",      "SQLite Editor"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
